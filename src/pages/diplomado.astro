---
// Landing de admisión "Diplomado en Masoterapia 2027" (maqueta "Página ONE TIME OFFER").
// El contenido es el de la maqueta; los precios vienen del producto de WooCommerce.
import { getCollection } from 'astro:content';
import LandingLayout from '../layouts/LandingLayout.astro';
import '../styles/diplomado-2027.css';

// Producto "Diplomado Anual en Masoterapia 2027" en WooCommerce (de aquí salen los precios).
const PRODUCT_ID = '4149';
// La inscripción se atiende por WhatsApp: todos los botones de inscripción llevan aquí.
const ENROLL_URL = 'https://wa.me/56944871048?text=' + encodeURIComponent('Hola, quiero inscribirme en el Diplomado en Masoterapia 2027.');
// Último día del valor promocional (hora de Chile). Debe coincidir con el fin de la oferta en WooCommerce.
const OFFER_LAST_DAY = '2026-10-31';
const OFFER_DEADLINE_TEXT = 'Hasta el 31 de octubre de 2026.';
const OFFER_DEADLINE_SHORT = 'Hasta el 31 de octubre';

const course = (await getCollection('curso')).find((entry) => entry.id === PRODUCT_ID);
if (!course) {
  throw new Error(`diplomado-masoterapia-2027: el producto ${PRODUCT_ID} no está en la colección de cursos`);
}
const { current, original } = course.data.price;
// Sin oferta vigente en WooCommerce se muestra solo el arancel.
const onOffer = original !== null;
const fullPrice = original ?? current;
---
<LandingLayout
  title="Cenakin Pro | Diplomado en Masoterapia 2027"
  description="Formación presencial de 150 horas en Viña del Mar. Aprende masoterapia profesional y las bases para emprender con tus propios servicios."
  image="/images/diplomado-masoterapia-2027-oferta.webp"
>
<header><a class="logo-lockup" href="https://cenakin.cl/" aria-label="Cenakin inicio"><span class="header-logo otec"><img src="/images/logo-otec-cenakin-hq-780.webp" alt="OTEC Cenakin" width="780" height="473"></span><span class="logo-divider" aria-hidden="true"></span><span class="header-logo cenakin"><img src="/images/logo-cenakin.png" alt="Cenakin" width="325" height="198"></span></a><nav><a href="#formacion">Formación</a><a href="#emprender">Emprendimiento</a><a href="#horarios">Horarios</a><a class="btn" href={ENROLL_URL} target="_blank" rel="noopener">Quiero inscribirme ↗</a></nav></header>
<main><div class="wrap"><section class="hero"><div><span class="eyebrow">Diplomado en Masoterapia · Admisión 2027</span><h1>Aprende masoterapia.<br><em>Prepárate para emprender.</em></h1><p>Una formación que conecta técnicas profesionales, atención responsable y conocimientos de marketing y negocios para desarrollar tus propios servicios.</p><div class="actions"><a class="btn" href={ENROLL_URL} target="_blank" rel="noopener">Conoce el valor e inscríbete ↗</a><a class="btn outline" href="#formacion">Explora el diplomado ↓</a></div><span class="mini">Presencial en Viña del Mar · Formación teórica y práctica evaluada</span></div><div class="hero-img"><img src="/images/diplomado-masoterapia-2027-oferta.webp" alt="Formación en masoterapia de Cenakin" fetchpriority="high"><div class="image-note"><strong>Tu técnica. Tu compromiso. Tu proyecto.</strong>Aprende a realizar una sesión y las bases para ofrecer tus servicios.</div></div></section><div class="facts"><div><small>Formación</small><strong>150 horas</strong></div><div><small>Duración</small><strong>10 meses</strong></div><div><small>Modalidad</small><strong>Presencial</strong></div><div><small>Inicio</small><strong>Marzo de 2027</strong></div></div></div>
<section class="section wrap" id="formacion"><div class="intro"><div><span class="eyebrow">El centro de tu formación</span><h2>Aprende la técnica.<br>Comprende su fundamento.<br>Practica con criterio.</h2></div><p>No se trata solo de aprender movimientos. En Cenakin aprenderás protocolos con fundamento, cómo estructurar una sesión y los criterios de atención que acompañan una práctica profesional. Tu aprendizaje se demuestra en la teoría y en la práctica.</p></div><div class="cards"><article class="card"><span class="num">01 / PREPARACIÓN TÉCNICA</span><h3>Técnicas y protocolos profesionales</h3><p>Fundamentos anatómicos, indicaciones, contraindicaciones y práctica supervisada para comprender qué aplicas y cómo realizarlo.</p></article><article class="card"><span class="num">02 / APRENDIZAJE EVALUADO</span><h3>El conocimiento se demuestra</h3><p>Estudio, teoría, práctica y evaluaciones. La aprobación exige completar las actividades y las 150 horas del programa.</p></article><article class="card"><span class="num">03 / ATENCIÓN PROFESIONAL</span><h3>Los detalles también forman</h3><p>Imagen personal, higiene, asepsia, vocabulario, puntualidad y cumplimiento: hábitos que influyen en la confianza de tus clientes.</p></article></div></section>
<section class="section dark" id="emprender"><div class="wrap business"><div><span class="eyebrow">Formación para desarrollar tu actividad propia</span><h2>Una buena técnica necesita una estructura para convertirse en un servicio.</h2><p>Complementa tu preparación con material en el aula virtual y talleres virtuales de marketing y negocios a cargo de profesionales de estas áreas.</p><p>El enfoque es emprender con tus propios servicios: aprender a organizarlos, promocionarlos y construir relaciones con tus clientes.</p></div><div class="steps"><article><span class="num">01</span><h3>Define tus precios</h3><p>Recibe orientación para establecer cuánto cobrar y ordenar tu oferta de servicios.</p></article><article><span class="num">02</span><h3>Transmite confianza</h3><p>Comprende cómo tu imagen, higiene y vocabulario influyen en la experiencia de atención.</p></article><article><span class="num">03</span><h3>Organiza la búsqueda de clientes</h3><p>Aprende que captar clientes requiere estructura y estrategias de marketing digital.</p></article><article><span class="num">04</span><h3>Construye fidelización</h3><p>Conecta una sesión bien realizada con una experiencia que motive a tus clientes a volver.</p></article></div></div></section>
<div class="ribbon"><div class="wrap"><p>La promoción atrae la atención. La calidad de tu servicio sostiene la confianza.</p><a href="#programa" class="btn outline">Ver plan de estudios ↓</a></div></div>
<section class="section wrap curriculum" id="programa"><div><span class="eyebrow">Tu ruta de aprendizaje</span><h2>Una formación progresiva, de la base a la práctica.</h2><p>Clases presenciales una vez por semana, demostración docente, práctica supervisada y apoyo en aula virtual.</p><p class="mini">Las técnicas se aplican en personas sanas o asintomáticas, con fines de bienestar y dentro del ámbito de la formación.</p></div><div>
<details open><summary><span class="num" style="margin:0">01</span>Fundamentos y atención profesional</summary><p>Protocolos de atención, ergonomía, indicaciones, contraindicaciones y práctica segura.</p></details><details><summary><span class="num" style="margin:0">02</span>Anatomía aplicada</summary><p>Anatomía humana y musculoesquelética, piel, circulación y sistema linfático.</p></details><details><summary><span class="num" style="margin:0">03</span>Masaje relajante y descontracturante</summary><p>Masaje relajante, descontracturante, piedras calientes y práctica presencial supervisada.</p></details><details><summary><span class="num" style="margin:0">04</span>Drenaje y masoterapia estética</summary><p>Drenaje linfático manual, masaje reductivo y anticelulítico, cuidado de la piel y fundamentos de estética corporal.</p></details><details><summary><span class="num" style="margin:0">05</span>Deportivo y técnicas complementarias</summary><p>Masaje deportivo, ventosaterapia, masaje en silla y reflexología podal.</p></details><details><summary><span class="num" style="margin:0">06</span>Ayurvédico y emprendimiento</summary><p>Masaje ayurvédico, técnica optativa, ética, atención de clientes y herramientas para desarrollar servicios independientes.</p></details></div></section>
<section class="section schedule" id="horarios"><div class="wrap"><span class="eyebrow">Organiza tu compromiso desde hoy</span><h2>Elige tu jornada para 2027.</h2><p>Formación presencial en Viña del Mar. Una jornada semanal durante diez meses.</p><div class="cards"><article class="card"><span class="tag">VESPERTINA</span><h3>Lunes</h3><strong>18:15 a 22:30 h</strong><p>8 de marzo al 13 de diciembre de 2027.</p><a href="https://wa.me/56944871048?text=Hola%2C%20quiero%20consultar%20cupos%20disponibles%20para%20el%20Diplomado%20en%20Masoterapia%202027%2C%20jornada%20Lunes%20vespertino." target="_blank" rel="noopener">Consultar cupos disponibles ↗</a></article><article class="card"><span class="tag">DIURNA</span><h3>Miércoles</h3><strong>09:15 a 13:30 h</strong><p>10 de marzo al 15 de diciembre de 2027.</p><a href="https://wa.me/56944871048?text=Hola%2C%20quiero%20consultar%20cupos%20disponibles%20para%20el%20Diplomado%20en%20Masoterapia%202027%2C%20jornada%20Mi%C3%A9rcoles%20diurno." target="_blank" rel="noopener">Consultar cupos disponibles ↗</a></article><article class="card"><span class="tag">FIN DE SEMANA</span><h3>Sábados</h3><strong>09:00 a 14:00 h</strong><p>6 de marzo al 18 de diciembre de 2027.</p><a href="https://wa.me/56944871048?text=Hola%2C%20quiero%20consultar%20cupos%20disponibles%20para%20el%20Diplomado%20en%20Masoterapia%202027%2C%20jornada%20S%C3%A1bados." target="_blank" rel="noopener">Consultar cupos disponibles ↗</a></article></div></div></section>
<section class="section wrap"><span class="eyebrow">Docentes profesionales</span><h2>Aprende con fundamentos y experiencia.</h2><div class="cards"><article class="card teacher"><h3>Jorge Rojas</h3><small>Kinesiólogo · Director académico</small><p>Formación en Kinesiología PUCV y pedagogía. Docente de masoterapia y aparatología, con formación en técnicas de masaje y drenaje linfático.</p></article><article class="card teacher"><h3>Guillermo Leiva</h3><small>Kinesiólogo · Masoterapeuta</small><p>Licenciado en Kinesiología UNAB. Diplomado en masoterapia Cenakin y formación en punción seca y ventosaterapia.</p></article><article class="card teacher"><h3>Tamara Bahamondes</h3><small>Nutricionista · Estética corporal</small><p>Licenciada en Nutrición y Dietética de la Universidad de Valparaíso. Formación en masaje reductivo, anticelulítico y drenaje linfático.</p></article></div></section>
<section class="wrap"><div class="commit"><div><span class="eyebrow">Tu compromiso es parte de la formación</span><h2>Para quienes quieren aprender y cumplir.</h2><p>Emprender exige responsabilidad. Esa preparación comienza en clases: respetar los horarios, estudiar, practicar y cumplir los compromisos que asumes.</p><p class="mini">Antes de matricularte, asegúrate de contar con el tiempo y la disposición para cumplir el programa y su reglamento.</p></div><ul class="checklist"><li>Llegar puntualmente a clases.</li><li>Cumplir la asistencia requerida.</li><li>Estudiar el material del aula virtual.</li><li>Entregar tareas y rendir evaluaciones.</li><li>Demostrar aprendizaje teórico y práctico.</li><li>Cuidar la presentación, higiene y asepsia.</li><li>Respetar las normas y compromisos del programa.</li></ul></div></section>
<section class="section wrap price" id="inscripcion"><div><span class="eyebrow">Da el siguiente paso</span><h2>Invierte en tu formación.<br>Construye las bases de tu emprendimiento.</h2><p>Incluye acceso al aula virtual, material de estudio digital, certificado digital de aprobación y diploma impreso.</p><h3>Requisitos de ingreso</h3><p>Ser mayor de 18 años y contar con licencia de enseñanza media. Para extranjeros, RUN definitivo o provisorio.</p><p class="mini">OTEC Cenakin N.º 19606 · Certificación NCh 2728 · Miembro de World Massage Federation.</p></div><div class="price-box" data-offer-last-day={onOffer ? OFFER_LAST_DAY : undefined} data-full-price={fullPrice}><span class="eyebrow" id="price-label">{onOffer ? 'Valor especial de inscripción' : 'Arancel del diplomado'}</span>{onOffer && <div class="old" id="old-price">{original}</div>}<div class="amount" id="amount">{current}</div><p style="margin:5px 0">Valor total · Todo medio de pago</p>{onOffer && <div class="deadline" id="deadline">{OFFER_DEADLINE_TEXT} Desde el 1 de noviembre: {original}.</div>}<div class="reglamento-links"><a href="/documentos/manual-convivencia-cenakin-2026.pdf" target="_blank" rel="noopener">Leer Manual de normas ↗</a></div><label class="approval"><input type="checkbox" id="commitment"><span>He leído el Manual de normas para alumnos y las exigencias de la formación, y tengo disposición para cumplirlas.</span></label><a class="btn disabled" id="enroll" href={ENROLL_URL} target="_blank" rel="noopener" aria-disabled="true">Inscribirme por WhatsApp →</a><p class="mini" style="margin:0;text-align:center">Te atenderemos por WhatsApp para completar tu inscripción.</p></div></section>
<section class="section wrap" style="padding-top:0"><div class="faq"><h2>Antes de inscribirte</h2><details><summary>¿Necesito experiencia previa?</summary><p>El programa parte desde fundamentos. Debes cumplir los requisitos de ingreso y asumir el estudio, la práctica y las evaluaciones.</p></details><details><summary>¿El diplomado está orientado a emprender?</summary><p>Sí. Su foco técnico se complementa con orientación en marketing digital, estructura de negocio, precios, atención y fidelización para desarrollar servicios propios.</p></details><details><summary>¿Terminaré con clientes agendados?</summary><p>Recibirás formación y herramientas para buscar clientes y organizar tu actividad. La captación depende de tu aplicación, continuidad y contexto; no se garantiza una cantidad de clientes ni ingresos.</p></details><details><summary>¿Cómo recibo mi certificación?</summary><p>Debes completar las 150 horas y aprobar las actividades y evaluaciones del programa. Recibirás certificado digital de aprobación y diploma impreso.</p></details><details><summary>¿Dónde se realiza la formación?</summary><p>En Viña del Mar: Calle Limache 1724, oficina 1102, Edificio Contemporáneo.</p></details></div></section></main>
<footer><div class="wrap"><div><a class="footer-brand" href="https://cenakin.cl/"><img src="/images/logo-cenakin.png" alt="Cenakin" width="125" height="76"></a><p>Formación profesional para desarrollar tus propios servicios.</p><p>© 2026 OTEC Cenakin · Diplomado en Masoterapia 2027</p></div><div><p>Calle Limache 1724, oficina 1102 · Viña del Mar</p><p>+56 9 4487 1048 · info@cenakin.cl</p><a href={`/cursos/${course.data.slug}/`} target="_blank" rel="noopener">Ver información institucional ↗</a></div></div></footer><div class="mobile-cta"><div><strong id="mobile-price">{current}</strong><small id="mobile-deadline">{onOffer ? OFFER_DEADLINE_SHORT : 'Arancel 2027'}</small></div><a class="btn" href={ENROLL_URL} target="_blank" rel="noopener">Inscríbete ↗</a></div>
<script>
  // La inscripción se habilita al confirmar que se leyó el Manual de normas.
  const check = document.getElementById('commitment') as HTMLInputElement;
  const enroll = document.getElementById('enroll') as HTMLAnchorElement;
  check.addEventListener('change', () => {
    enroll.classList.toggle('disabled', !check.checked);
    enroll.setAttribute('aria-disabled', String(!check.checked));
  });
  enroll.addEventListener('click', (event) => {
    if (!check.checked) {
      event.preventDefault();
      check.focus();
    }
  });

  // Pasado el último día de la promoción (hora de Chile), se muestra el arancel completo
  // aunque la página no se haya vuelto a publicar.
  const box = document.querySelector<HTMLElement>('.price-box');
  const lastDay = box?.dataset.offerLastDay;
  const fullPrice = box?.dataset.fullPrice ?? '';
  const chileDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  if (lastDay && chileDate > lastDay) {
    document.getElementById('old-price')!.hidden = true;
    document.getElementById('amount')!.textContent = fullPrice;
    document.getElementById('price-label')!.textContent = 'Arancel del diplomado';
    document.getElementById('deadline')!.textContent = 'La promoción de octubre finalizó. Consulta las condiciones de inscripción vigentes.';
    document.getElementById('mobile-price')!.textContent = fullPrice;
    document.getElementById('mobile-deadline')!.textContent = 'Arancel 2027';
  }
</script>
</LandingLayout>
