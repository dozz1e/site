---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Cenakin | Contacto"
  description="¿Tienes dudas sobre nuestros cursos o el proceso de inscripción? Escríbenos y te ayudamos a encontrar la formación adecuada."
  headerVariant="detail"
>
  <main class="contacto-page">
    <section class="catalog-hero">
      <div>
        <p class="crumb">Inicio <span>›</span> Contacto</p>
        <p class="eyebrow">HABLEMOS</p>
        <h1>Contacto</h1>
        <p class="intro">¿Tienes dudas sobre nuestros cursos o el proceso de inscripción? Escríbenos y te ayudamos a encontrar la formación adecuada.</p>
      </div>
    </section>

    <div class="contact-page-container">
      <section class="detail-section contact-section">
        <div class="contact-grid">
          <div class="contact-info">
            <div>
              <h3>Dirección</h3>
              <p>Calle Limache 1724, oficina 1102<br />Ed. Contemporáneo, Viña del Mar</p>
            </div>
            <div>
              <h3>Horario</h3>
              <p>Lunes a Viernes de 9:30 a 13:00<br />y 15:00 a 17:30 hrs.</p>
            </div>
            <div>
              <h3>Contacto</h3>
              <a href="https://wa.me/56944871048?text=Hola%20me%20gustar%C3%ADa%20contactarme" target="_blank" rel="noreferrer">WhatsApp: +56 9 4487 1048</a>
              <a href="tel:+56944871048">Teléfono: +56 9 4487 1048</a>
              <a href="mailto:info@cenakin.cl">Email: info@cenakin.cl</a>
            </div>
          </div>
          <div class="contact-map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3345.0373071833806!2d-71.54200622347714!3d-33.02914757606182!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9689ddc28f9fad87%3A0xc04b1826cc0704ae!2sCenakin!5e0!3m2!1ses-419!2scl!4v1754674109576!5m2!1ses-419!2scl"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación de Cenakin en Viña del Mar"
            ></iframe>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
