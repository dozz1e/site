<div class="advisor-overlay" role="presentation" hidden>
  <section class="advisor" role="dialog" aria-modal="true" aria-labelledby="advisor-title">
    <header>
      <div>
        <small>ATENCIÓN Y ORIENTACIÓN</small>
        <h2 id="advisor-title">WhatsApp Cenakin</h2>
      </div>
      <button type="button" class="advisor-close" aria-label="Cerrar">×</button>
    </header>
    <div class="advisor-body"></div>
    <footer hidden>
      <button type="button" class="advisor-back">← Volver al inicio</button>
      <span>Tu información solo se enviará cuando abras WhatsApp.</span>
    </footer>
  </section>
</div>
<script src="../scripts/whatsappAdvisor.js"></script>
