  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M16.001 3C9.373 3 4 8.373 4 15c0 2.386.697 4.611 1.899 6.484L4 29l7.708-1.867A11.94 11.94 0 0 0 16.001 27C22.628 27 28 21.627 28 15S22.628 3 16.001 3zm6.994 16.851c-.297.836-1.469 1.53-2.406 1.729-.64.135-1.475.243-4.287-.921-3.598-1.489-5.913-5.145-6.093-5.386-.173-.242-1.457-1.939-1.457-3.698 0-1.759.898-2.622 1.217-2.982.318-.36.694-.45.925-.45.231 0 .462.002.664.012.213.01.499-.081.78.596.297.716.999 2.475 1.086 2.655.087.18.145.393.029.635-.116.242-.174.393-.347.605-.174.211-.365.472-.522.634-.174.18-.355.376-.153.738.203.362.902 1.489 1.937 2.412 1.331 1.19 2.454 1.559 2.816 1.735.362.176.573.148.784-.09.213-.238.907-1.059 1.15-1.421.242-.362.484-.301.814-.181.331.121 2.096.988 2.456 1.168.36.18.6.27.688.42.087.15.087.87-.211 1.706z"/></svg>
