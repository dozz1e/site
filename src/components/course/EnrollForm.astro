---
interface Props {
  course: string;
}
const { course } = Astro.props;
---
<aside class="enroll-card inquiry-card" id="inscripcion">
  <span class="enroll-label">ORIENTACIÓN PERSONALIZADA</span>
  <h2>Deja tus datos para más información</h2>
  <p>Te contactaremos para resolver tus dudas y ayudarte con la inscripción.</p>
  <form class="sticky-form" id="form-inscripcion">
    <input type="hidden" name="curso" value={course} />
    <label>Nombre completo<input type="text" name="nombre" placeholder="Tu nombre" required /></label>
    <label>Correo electrónico<input type="email" name="email" placeholder="tucorreo@ejemplo.com" required /></label>
    <div class="sticky-form-row">
      <label>WhatsApp<input type="tel" name="telefono" placeholder="+56 9..." required /></label>
      <label>Ciudad<input type="text" name="ciudad" placeholder="Viña del Mar" required /></label>
    </div>
    <label>
      ¿Cuándo te gustaría iniciar?
      <select name="inscripcion">
        <option value="" disabled selected>¿Cuándo te gustaría iniciar?</option>
        <option value="Quiero inscribirme ahora.">Quiero inscribirme ahora.</option>
        <option value="Quiero iniciar este mes.">Quiero iniciar este mes.</option>
        <option value="Estoy evaluando para más adelante.">Estoy evaluando para más adelante.</option>
        <option value="Solo quiero información.">Solo quiero información.</option>
      </select>
    </label>
    <button type="submit">Quiero más detalles <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
  </form>
  <div class="form-success" id="form-success" hidden>
    <p><strong>¡Solicitud enviada!</strong></p>
    <p>Gracias por tu interés. Un asesor se pondrá en contacto contigo pronto vía WhatsApp o correo electrónico.</p>
  </div>
  <div class="enroll-contact">
    <span>⌖ Calle Limache 1724, oficina 1102</span>
    <a href="tel:+56944871048">☏ +56 9 4487 1048</a>
    <a href="mailto:info@cenakin.cl">✉ info@cenakin.cl</a>
  </div>
</aside>

<script>
  const form = document.getElementById('form-inscripcion') as HTMLFormElement | null;
  const successMessage = document.getElementById('form-success');

  if (form && successMessage) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalLabel = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.textContent = 'ENVIANDO...';

      try {
        const response = await fetch('https://cenakin.cl/otec/correo4.php', {
          method: 'POST',
          body: new FormData(form),
        });

        if (!response.ok) {
          throw new Error('Error en el servidor');
        }

        form.hidden = true;
        successMessage.hidden = false;
        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        console.error('Error al enviar el formulario:', error);
        alert('No se pudo enviar el formulario. Por favor, inténtalo de nuevo o contáctanos directamente.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalLabel;
      }
    });
  }
</script>
