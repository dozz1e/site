---
const links = [
  ['home', '/', 'INICIO'],
  ['diploma', '/#diplomado', 'DIPLOMADO 2026'],
  ['courses', '/categorias#masajes', 'CURSOS MASOTERAPIA'],
  ['health', '/categorias#salud', 'CURSOS SALUD'],
  ['business', '/categorias#marketing', 'CURSOS EMPRENDIMIENTO'],
  ['online', '/categorias#online', 'FORMACIONES ONLINE'],
  ['virtual', 'https://aulavirtualcenakin.com/', 'AULA VIRTUAL'],
];

const icons: Record<string, string[]> = {
  home: ['m3 11 9-8 9 8', 'M5 10v10h14V10M9 20v-6h6v6'],
  diploma: ['m3 9 9-5 9 5-9 5z', 'M5 12v6M9 14v4M15 14v4M19 12v6M3 21h18'],
  courses: [
    'M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22z',
    'M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22z',
  ],
  health: ['M12 21s8-4.8 8-12a4.5 4.5 0 0 0-8-2.8A4.5 4.5 0 0 0 4 9c0 7.2 8 12 8 12z', 'M8 12h2l1-3 2 6 1-3h2'],
  business: ['M4 21V8l8-5 8 5v13M8 21v-5h8v5', 'M8 10h2M14 10h2'],
  online: ['M8 21h8M12 17v4M9 9l2 2 4-4'],
  virtual: ['m3 11 9-8 9 8', 'M5 10v10h14V10M9 20v-7h6v7', 'M12 7v3'],
};
---
<button class="mobile-menu-button" type="button" aria-label="Abrir menú" aria-expanded="false">
  <span></span><span></span><span></span><b>MENÚ</b>
</button>
<div class="mobile-menu-layer" aria-hidden="true">
  <button class="mobile-menu-backdrop" type="button" aria-label="Cerrar menú"></button>
  <aside class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Menú principal">
    <div class="mobile-menu-brand">
      <a href="/" class="mobile-menu-logo">
        <img src="/images/logo-otec-cenakin-hq-780.webp" alt="OTEC Cenakin" loading="lazy" decoding="async" width="780" height="473" />
        <i></i>
        <img src="/images/logo-cenakin.png" alt="Cenakin" loading="lazy" decoding="async" width="325" height="198" />
      </a>
      <button class="mobile-menu-close" type="button" aria-label="Cerrar menú">×</button>
    </div>
    <nav>
      {links.map(([icon, href, label]) => (
        <a href={href}>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            {icon === 'online' && <rect x="3" y="4" width="18" height="13" rx="2" />}
            {icons[icon].map((d) => <path d={d} />)}
          </svg>
          <span>{label}</span>
          <b>›</b>
        </a>
      ))}
    </nav>
    <div class="mobile-menu-contact">
      <p>¿Necesitas orientación?</p>
      <a class="mobile-menu-whatsapp" href="https://wa.me/56944871048">Escríbenos por WhatsApp <span>→</span></a>
    </div>
  </aside>
</div>
<script src="../scripts/mobileMenu.js"></script>
