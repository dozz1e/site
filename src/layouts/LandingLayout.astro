---
// Layout para páginas de campaña con diseño propio (cabecera, pie y estilos de la página).
// No carga global.css; comparte con el resto del sitio el <head> (metadatos y medición).
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image } = Astro.props;
---
<html lang="es">
  <head>
    <SiteHead title={title} description={description} image={image} />
  </head>
  <body>
    <slot />
  </body>
</html>
