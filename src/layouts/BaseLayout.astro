---
import '../styles/global.css';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import WhatsAppAdvisor from '../components/WhatsAppAdvisor.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description: string;
  headerVariant: 'home' | 'detail';
  image?: string;
  type?: 'website' | 'article';
  /** false: la página trae su propia cabecera y pie (p. ej. las páginas legales). */
  chrome?: boolean;
  /** true: página que no debe indexarse ni declarar canonical (p. ej. la 404). */
  noindex?: boolean;
}
const { title, description, headerVariant, image, type, chrome = true, noindex = false } = Astro.props;
---
<html lang="es">
  <head>
    <SiteHead title={title} description={description} image={image} type={type} noindex={noindex} />
  </head>
  <body>
    {chrome && (
      <Header variant={headerVariant}>
        <MobileMenu slot="mobile-menu" />
      </Header>
    )}
    <slot />
    {chrome && <Footer />}
    {chrome && <WhatsAppAdvisor />}
    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const sections = document.querySelectorAll<HTMLElement>('main section');
        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-in');
                obs.unobserve(entry.target);
              }
            }
          },
          // Se muestra en cuanto la sección entra a la pantalla (sin exigir un % de su alto):
          // con un umbral porcentual, las secciones muy altas en mobile nunca llegaban a aparecer.
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        sections.forEach((section) => {
          section.classList.add('reveal-init');
          observer.observe(section);
        });
      }
    </script>
  </body>
</html>
